{
  "name": "febracis-ops",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "server.cjs",
  "scripts": {
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=server.bundle.cjs --packages=external",
    "start": "node --experimental-sqlite server.cjs",
    "postinstall": "npm install --prefix server --omit=dev --no-audit --no-fund || true"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "google-auth-library": "^11.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
